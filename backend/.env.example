# RoadFix — Backend Environment Variables
# Copy this file to .env and fill in your values.

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=roadfix

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# ─── JWT (CHANGE THESE IN PRODUCTION!) ────────────────────────────────────────
JWT_ACCESS_SECRET=roadfix_access_super_secret_change_in_production_2026
JWT_REFRESH_SECRET=roadfix_refresh_super_secret_change_in_production_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── AI (Optional — features degrade gracefully without this) ─────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Cloudinary (Optional — falls back to local storage without this) ─────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email Notifications (Optional) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=RoadFix <noreply@roadfix.com>

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
